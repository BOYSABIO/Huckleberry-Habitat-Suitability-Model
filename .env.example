# Optional local overrides (copy to .env — never commit .env).
#
# Homelab / LAN: add your LXC's LAN address so the MLflow UI works from other
# machines on your network (avoids "Invalid Host header" from MLflow 3.x).
# Replace the placeholder with your container's IP; do not commit real values.
#
# MLFLOW_ALLOWED_HOSTS=mlflow:5000,localhost:*,127.0.0.1:*,host.docker.internal:*,<YOUR-LXC-IP>:5000
#
# Or allow a private subnet (example only — adjust to match your LAN):
# MLFLOW_ALLOWED_HOSTS=mlflow:5000,localhost:*,127.0.0.1:*,192.168.*.*
